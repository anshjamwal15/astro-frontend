<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for specific domains -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">3.108.112.130</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
    </domain-config>
    
    <!-- For development: Allow all cleartext traffic (remove in production) -->
    <!-- Uncomment the line below if you need to allow all HTTP traffic -->
    <!-- <base-config cleartextTrafficPermitted="true" /> -->
</network-security-config>
